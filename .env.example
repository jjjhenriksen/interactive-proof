OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
EXPLAIN_RATE_LIMIT_PER_HOUR=30
# Required for production explanations; omit both only for local dev/test.
# Use the same Redis database and credentials across every replica/edge isolate.
EXPLAIN_QUOTA_REDIS_REST_URL=
EXPLAIN_QUOTA_REDIS_REST_TOKEN=

# Required explicitly for production builds. The unresolved package is omitted.
PUBLIC_PROOF_IDS=odd-sum-square
