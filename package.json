{
  "name": "interactive-proof",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "predev": "npm run proof:registry",
    "dev": "next dev",
    "prebuild": "npm run proof:registry",
    "build": "next build",
    "prebuild:sites": "npm run proof:registry",
    "build:sites": "vinext build",
    "start:sites": "vinext start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/reader-smoke.spec.ts tests/e2e/methodology.spec.ts --project=chromium",
    "eval:validate": "tsx scripts/validate-evaluations.ts",
    "eval:live": "tsx scripts/run-live-evaluations.ts",
    "proof:registry": "tsx scripts/build-proof-registry.ts",
    "release:check": "tsx scripts/check-public-release.ts",
    "proof:verify": "tsx scripts/verify-proof-packages.ts",
    "proof:validate": "tsx scripts/validate-proof-packages.ts",
    "proof:extract": "node --experimental-strip-types scripts/extract-paper-pages.ts",
    "proof:new": "tsx scripts/proof-new.ts",
    "proof:check": "tsx scripts/proof-check.ts",
    "proof:preview": "tsx scripts/proof-preview.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.19",
    "ws": "8.21.1"
  },
  "type": "module"
}
